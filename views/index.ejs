<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- <link rel="stylesheet" href="/stylesheets/style.css" -->
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Document</title>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-600 text-white">
        
        <div class="form p-5">
            <form action="/create" method="post">
                <input class="block w-full rounded-md outline-none px-5 py-3 bg-zinc-800" type="text" placeholder="Title goes here" name="title">
                <textarea class="block w-full rounded-md outline-none mt-2 px-5 py-3 bg-zinc-800 resize-none" placeholder="Write your task here" name="details"> </textarea>
                <input class="mt-2 bg-blue-600 px-5 py-2 rounded-md" type="submit" value="Create task">
            </form>
        </div>

        <div class="'tasks p-5 flex gap-2 flex-wrap">
            <% if(files.length > 0){ %>
                <% files.forEach(function(val){ %>
                    <div class="task min-w-72 px-3 py-4 rounded-md bg-zinc-800">
                <h1 class="text-white tracking-tight text-xl"><%= val %></h1>
                <div class=" mt-2 flex w-full justify-between item-center " >
                    <a class="text-blue-400 inline-block " href="/file/<%= val %>">Read more</a>
                    <a class="text-blue-400" href="/edit/<%= val %>">edit</a>
                </div>

            </div>
                <% }) %>
            <% } else { %>
                <h1 class="text-white">No tasks found</h1>
                <% }%>
            

        </div>

    </div>
</body>
</html>