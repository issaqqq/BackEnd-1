<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- <link rel="stylesheet" href="/stylesheets/style.css" -->
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Document</title>
</head>
<body>
    <div class="p-5 main w-full min-h-screen bg-zinc-600 text-white">
        <a class="mt-3 mb-7 inline-block text-blue-500" href="/">Go back to home</a>
        <form class="" action="/edit" method="post">
                <input class="block w-1/3 rounded-md outline-none px-5 py-3 bg-zinc-800" type="text" placeholder="Previous Title" name="previous" value="<%= filename %>" >
                <input class="mt-2 block w-1/3 rounded-md outline-none px-5 py-3 bg-zinc-800" type="text" placeholder="New Titile" name="new">
                <input class="mt-2 bg-blue-600 px-5 py-2 rounded-md" type="submit" value="Update name">
            </form>
    </div>
</body>
</html>